# ==========================================
# 1. DATOS DEL PROYECTO (¡LO MÁS IMPORTANTE!)
# ==========================================
# Ignorar bases de datos locales y artefactos legacy
*.db
*.sqlite3
legacy/
Legacy/
**/Legacy/
backend/dataset_lsm_v1.db

# Ignorar archivos físicos de recolección de IA
*.npy
backend/dataset/
backend/muestras/
dataset_lsm/
backend/videos/

# Ignorar outputs generados de la app
frontend/dist/
frontend/.vite/
frontend/node_modules/
backend/__pycache__/
package-lock.json
*.log

# ==========================================
# 2. BACKEND (Python / FastAPI)
# ==========================================
# Entornos virtuales
env/
venv/
.venv/
env_*/

# Archivos compilados de Python
__pycache__/
*.py[cod]
*$py.class

# ==========================================
# 3. FRONTEND (React / Node.js)
# ==========================================
# Dependencias masivas (¡Nunca subir esto!)
node_modules/
frontend/node_modules/

# Logs de error
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Archivos de producción (cuando compiles Vite)
dist/
dist-ssr/
build/

# ==========================================
# 4. VARIABLES DE ENTORNO Y SEGURIDAD
# ==========================================
# Para cuando uses contraseñas reales de AWS/PostgreSQL
.env
.env.*
!.env.example
backend/.env

# ==========================================
# 5. ARCHIVOS DEL SISTEMA Y EDITORES (Basura)
# ==========================================
.vscode/
.idea/
.DS_Store
Thumbs.db